---
import { t } from "i18next";
// import { SEO } from "astro-seo"; // https://github.com/jonasmerlin/astro-seo
import { HeadHrefLangs } from "astro-i18next/components";
// import cardImage from "./share.png"
const title = Astro.props.title
    ? "TO: " + Astro.props.title
    : "Truthonly.com";

const description = Astro.props.description || t("description")
const canonicalURL = Astro.site+Astro.url.pathname.replace(/^\/+/, '')
---

<meta charset="utf-8">
<meta http-equiv="content-type" content="text/html; charset=utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="dark" />
<title>{ title }</title>
<meta name="title" content={ title } />
<meta name="description" content={ description } />
<meta name="keywords" content={ Astro.props.keywords?.join(", ") } />
<meta property="og:image" content={ Astro.site + "assets/og.jpg" } />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Truth is discovered." />
<meta property="fb:app_id" content="966242223397117" />
<meta property="og:description" content={ description } />
<meta property="og:url" content={ canonicalURL } />
<meta property="og:type" content="website" />
<meta property="og:title" content={ title } />
<meta name="twitter:url" content={ canonicalURL }>
<meta name="twitter:site" content="@dkotik">
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ title } />
<meta name="twitter:description" content={ description } />
<meta name="twitter:image" content={ Astro.site + "assets/og.jpg" } />
<meta name="twitter:image:width" content="1200" />
<meta name="twitter:image:height" content="630" />
<meta name="twitter:image:alt" content="Truth is discovered." />

<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={ canonicalURL }>
