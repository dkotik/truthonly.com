---
import { t } from "i18next";
import { SEO } from "astro-seo"; // https://github.com/jonasmerlin/astro-seo
import { HeadHrefLangs } from "astro-i18next/components";
import cardImage from "./share.png"
const title = Astro.props.title
    ? "TO: " + Astro.props.title
    : "Truthonly.com";
---

<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="content-type" content="text/html; charset=utf-8" />
<meta charset="utf-8">
<meta name="color-scheme" content="dark" />
<link rel="sitemap" href="/sitemap-index.xml" />
<SEO
  title={ title }
  description={ Astro.props.description || t("description") }
  openGraph={{
    basic: {
        title: title,
        "type": "website",
        image: cardImage
    },
    image: {
        alt: title,
        height: 225,
        width: 255
    }
  }}
  extend={{
      meta: [
        {
            name: "keywords",
            content: Astro.props.keywords?.join(", ")
        },
        {
            property: "og:description",
            content: Astro.props.description || t("description")
        }
      ]
  }} />
<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
