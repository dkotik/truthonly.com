---
import { getCollection, getEntry } from 'astro:content';

const articles = await getCollection(
  "articles",
  ({ data }) => {
    return !data.draft
  }
);
---

<nav>

<div>
    <h2>History</h2>
    <ul>
    {
        articles.filter(article => article.filePath.match(/^src\/content\/en\/history\//))
            .map(article =>
                <li>
                    <a href={"/en/history/" + article.filePath.replace(/^src\/content\/en\/history\//, "").replace(/\.mdx$/, ".html")}>
                        { article.data.title }
                    </a>
                </li>
            )
    }
    </ul>
</div>

<div>
<h2>Philosophy</h2>
<ul>
{
    articles.filter(article => article.filePath.match(/^src\/content\/en\/philosophy\//))
        .map(article =>
            <li>
                <a href={"/en/philosophy/" + article.filePath.replace(/^src\/content\/en\/philosophy\//, "").replace(/\.mdx$/, ".html")}>
                    { article.data.title }
                </a>
            </li>
        )
}
</ul>
</div>

<div>
<h2>Society</h2>
<ul>
{
    articles.filter(article => article.filePath.match(/^src\/content\/en\/society\//))
        .map(article =>
            <li>
                <a href={"/en/society/" + article.filePath.replace(/^src\/content\/en\/society\//, "").replace(/\.mdx$/, ".html")}>
                    { article.data.title }
                </a>
            </li>
        )
}
</ul>
</div>

</nav>

<style>
nav {
    display: grid;
    max-width: 60em;
    grid-template-columns: 1fr 1fr 1fr;
    grid-column-gap: 2em;
    grid-row-gap: 2em;
    margin: 0 auto;
}
</style>
